../F2806x_common/source/F2806x_CSMPasswords.asm                      PAGE    2

      56              ; (PWL) are programmed.  If security is not a concern, then these addresses
      57              ; can be used for code or data.  
      58              
      59              ; The section "csm_rsvd" can be used to program these locations to 0x0000.
      60              
      61 00000000               .sect "csm_rsvd"
      62                      .loop (3F7FF5h - 3F7F80h + 1)
      63                            .int 0x0000
      64                      .endloop

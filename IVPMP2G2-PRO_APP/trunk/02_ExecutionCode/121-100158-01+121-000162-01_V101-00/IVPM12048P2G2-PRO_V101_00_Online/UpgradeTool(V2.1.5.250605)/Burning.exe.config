<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/>
    </startup>
    <appSettings>
      <add key="HBMS" value="BMSHIAP"></add>
      <add key="T_ST" value="IVEM3024#IVEM5048"></add>
      <add key="T_SUM" value="V350"></add>
      <add key="T_CRC" value="F5PN01CRC#APP"></add>
      <add key="T_NOCHK" value="MCUNS"></add>
      <add key="FlashStart" value="84000"></add>
      <add key="FlashEnd" value="AFFFF"></add>
      <add key="SendRowsEach" value="4"></add>
    </appSettings>
</configuration>

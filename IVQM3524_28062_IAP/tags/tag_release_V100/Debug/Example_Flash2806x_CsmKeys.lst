      13              
      14              ; Use this file to pass key values to the Example Flash program
      15              ; to unlock the Code Security module before attempting to erase,
      16              ; program or verify the part. 
      17              
      18              
      19                        .global _PRG_key0
      20                        .global _PRG_key1
      21                        .global _PRG_key2
      22                        .global _PRG_key3
      23                        .global _PRG_key4
      24                        .global _PRG_key5
      25                        .global _PRG_key6
      26                        .global _PRG_key7
      27              
      28              ; For erased flash the password locations will all be 0xFFFF       
      29 00000000                  .text                         
      30 00000000 FFFF  _PRG_key0  .word 0xFFFF  ; PSWD bits 15-0
      31 00000001 FFFF  _PRG_key1  .word 0xFFFF  ; PSWD bits 31-16
      32 00000002 FFFF  _PRG_key2  .word 0xFFFF  ; PSWD bits 47-32
      33 00000003 FFFF  _PRG_key3  .word 0xFFFF  ; PSWD bits 63-48
      34 00000004 1314  _PRG_key4  .word 0x1314  ; PSWD bits 79-64
      35 00000005 2046  _PRG_key5  .word 0x2046  ; PSWD bits 95-80
      36 00000006 1284  _PRG_key6  .word 0x1284  ; PSWD bits 111-96
      37 00000007 9550  _PRG_key7  .word 0x9550  ; PSWD bits 127-112
